@* Three-point distribution: type, min, most likely, max. *@
<span class="filter">
    <select class="input sm" @bind="Dist.Distribution" title="Distribution" aria-label="Distribution">
        <option value="triangle">Triangle</option>
        <option value="pert">PERT</option>
        <option value="uniform">Uniform</option>
    </select>
    <input class="input sm" type="number" step="any" @bind="Dist.Min" title="Minimum" aria-label="Minimum" />
    @if (Dist.Distribution != "uniform")
    {
        <input class="input sm ml" type="number" step="any" @bind="Dist.MostLikely" title="Most likely" aria-label="Most likely" />
    }
    <input class="input sm" type="number" step="any" @bind="Dist.Max" title="Maximum" aria-label="Maximum" />
    @if (Dist.Validate() is string err)
    {
        <span class="tag tag-accent" title="@err">! @err</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public DistSpec Dist { get; set; } = null!;
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The app's screens and services, shared by the browser app (ScheduleRisk.Web) and the Windows app
       (ScheduleRisk.Desktop). The namespace stays ScheduleRisk.Web so the components kept their names when they moved here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>ScheduleRisk.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScheduleRisk.Core\ScheduleRisk.Core.csproj" />
  </ItemGroup>

</Project>

@inherits StateComponent
@inject ReportExporter Exporter

<nav class="nav topnav">
    <div class="brandcell">
        <span class="brandmark" aria-hidden="true"></span>
        <span class="nav-brand">Schedule Risk</span>
    </div>
    <div class="projcell">
        <span class="eyebrow">Project</span>
        <span class="projname" title="@State.FileName">@ProjectLabel</span>
    </div>
    <div class="steps">
        @foreach (var (n, label) in Steps)
        {
            <button class="step @(tab == n ? "on" : "")" disabled="@(n > 1 && State.Cpm == null)" aria-current="@(tab == n ? "step" : null)"
                    @onclick="@(() => Go(n))"><span class="n">0@(n)</span>@label</button>
        }
    </div>
    <div class="navactions" title="Runs locally · no data leaves this device">
        <button class="btn btn-primary" disabled="@(State.Pre == null)" @onclick="@(() => reportOpen = true)">Report ↓</button>
    </div>
</nav>

@if (State.Error != null)
{
    <div class="banner error" role="alert">
        <span>@State.Error</span>
        <button class="btn btn-ghost" @onclick="@(() => { State.Error = null; })">Dismiss</button>
    </div>
}

<main class="page">
    @if (tab == 1)
    {
        <SchedulePanel OnNext="@(() => Go(2))" />
    }
    else if (tab == 2)
    {
        <RiskModelPanel OnRun="RunFromModel" />
    }
    else
    {
        <ResultsPanel />
    }
</main>

@if (reportOpen && State.Pre != null)
{
    <div class="dialog-backdrop" @onclick="@(() => reportOpen = false)">
        <div class="dialog report-dialog" role="dialog" aria-modal="true" aria-labelledby="report-title" @onclick:stopPropagation="true">
            <div class="dialog-title" id="report-title">Export risk report</div>
            <div class="field">
                <label id="fmt-label">Format</label>
                <div class="fmt-list" role="radiogroup" aria-labelledby="fmt-label">
                @foreach (var (f, ext, note) in Formats)
                {
                    <label class="radio fmt-opt">
                        <input type="radio" name="fmt" checked="@(format == f)" @onchange="@(() => format = f)" />
                        <span class="dot"></span>
                        <span class="fmt-text"><b>@ReportExporter.Name(f)</b> <span class="fmt-ext">@ext</span><span class="fmt-note">@note</span></span>
                    </label>
                }
                </div>
            </div>
            <div class="dialog-note">@ReportSummary</div>
            <div class="dialog-actions">
                <button class="btn btn-secondary" @onclick="@(() => reportOpen = false)">Cancel</button>
                <button class="btn btn-primary btn-wide" @onclick="Export">Download</button>
            </div>
        </div>
    </div>
}

@if (State.Busy)
{
    <div class="busy"><div class="dialog"><div class="dialog-title">@State.BusyText</div><div class="dialog-body">This runs on your computer, in this tab.</div></div></div>
}

@code {
    private static readonly (int N, string Label)[] Steps = { (1, "Schedule"), (2, "Risk model"), (3, "Results") };

    private static readonly (ReportFormat Format, string Ext, string Note)[] Formats =
    {
        (ReportFormat.Pdf, ".pdf", "A4 document with the summary, charts and tables, ready to print or send."),
        (ReportFormat.Word, ".docx", "The same A4 document to edit in Word; tables stay tables."),
        (ReportFormat.PowerPoint, ".pptx", "16:9 slides: the summary, one slide per chart, tables that stay editable."),
        (ReportFormat.Html, ".html", "One self-contained page that opens in any browser."),
        (ReportFormat.Csv, ".csv", "Three files for a spreadsheet: activities, risks and every iteration's finish."),
    };

    private int tab = 1;
    private bool reportOpen;
    private ReportFormat format = ReportFormat.Pdf;

    private string ProjectLabel => State.Schedule == null ? "No schedule loaded"
        : State.FileName is { } f ? $"{State.Schedule.ProjectCode} · {f}" : State.Schedule.ProjectCode;

    private string ReportSummary
    {
        get
        {
            var pre = State.Pre!;
            long q = Statistics.PercentileSorted(pre.SortedFinish, State.Percentile);
            return $"{State.Schedule?.ProjectCode} · {pre.Iterations:N0} iterations · seed {pre.Seed} · P{State.Percentile} {AppState.Day(q)}"
                + (State.Post != null ? " · pre- and post-mitigation" : "");
        }
    }

    private async Task Export()
    {
        reportOpen = false;
        switch (format)
        {
            case ReportFormat.Csv: await DownloadTables(); break;
            case ReportFormat.Html: await DownloadReport(); break;
            default: await Exporter.ExportAsync(format); break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("sraWatchNav");
    }

    private async Task Go(int n)
    {
        tab = n;
        await JS.InvokeVoidAsync("scrollTo", 0, 0);
    }

    private async Task RunFromModel()
    {
        await Go(3);
        StateHasChanged();
        await State.RunAsync();
    }
}

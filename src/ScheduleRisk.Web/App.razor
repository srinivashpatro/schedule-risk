@inherits StateComponent

<nav class="nav topnav">
    <div class="brandcell">
        <span class="brandmark" aria-hidden="true"></span>
        <span class="nav-brand">Project Risk Analysis</span>
    </div>
    <div class="projcell">
        <span class="eyebrow">Project</span>
        <span class="projname" title="@State.FileName">@ProjectLabel</span>
    </div>
    <span class="spacer"></span>
    <div class="navactions" title="Runs locally · no data leaves this device">
        <button class="btn btn-primary" disabled="@(State.Pre == null)" @onclick="@(() => Go(WorkflowStep.Review))">Report ↓</button>
    </div>
</nav>

@if (State.Error != null)
{
    <div class="banner error" role="alert">
        <span>@State.Error</span>
        <button class="btn btn-ghost" @onclick="@(() => { State.Error = null; })">Dismiss</button>
    </div>
}

<div class="shell">
    <nav class="workflow" aria-label="Risk workflow">
        <ol>
            @foreach (var s in Workflow.Steps)
            {
                <li>
                    <button class="wf-step @(Current == s.Step ? "on" : "") @(s.Bridge ? "bridge" : "")" disabled="@(!Enabled(s.Step))"
                            aria-current="@(Current == s.Step ? "step" : null)" @onclick="@(() => Go(s.Step))">
                        <span class="wf-n" aria-hidden="@(s.Bridge ? "true" : null)">@(s.Bridge ? "→" : s.Number)</span>
                        <span class="wf-text"><span class="wf-title">@s.Title</span><span class="wf-desc">@s.Description</span></span>
                    </button>
                </li>
            }
        </ol>
    </nav>

    <main class="page">
        @switch (Current)
        {
            case null or WorkflowStep.ScheduleCheck:
                <SchedulePanel OnNext="@(() => Go(WorkflowStep.Model))" />
                break;
            case WorkflowStep.Setup:
                <SetupPanel />
                break;
            case WorkflowStep.Identify:
                <IdentifyPanel />
                break;
            case WorkflowStep.Assess:
                <AssessPanel />
                break;
            case WorkflowStep.Model:
                <RiskModelPanel OnRun="RunFromModel" />
                break;
            case WorkflowStep.Results:
                <ResultsPanel />
                break;
            case WorkflowStep.Review:
                <ReviewPanel />
                break;
            case { } s:
                <StepPlaceholder Info="@Workflow.Get(s)" />
                break;
        }
    </main>
</div>

@if (State.Busy)
{
    <div class="busy"><div class="dialog"><div class="dialog-title">@State.BusyText</div><div class="dialog-body">This runs on your computer, in this tab.</div></div></div>
}

@code {
    // No step is chosen until the user picks one: the landing page (where a schedule is opened) shows, and once a
    // schedule is open it counts as step 04 · Schedule check.
    private WorkflowStep? step;

    private WorkflowStep? Current => step ?? (State.Schedule != null ? WorkflowStep.ScheduleCheck : null);

    private string ProjectLabel => State.Schedule == null ? "No schedule loaded"
        : State.FileName is { } f ? $"{State.Schedule.ProjectCode} · {f}" : State.Schedule.ProjectCode;

    // Setup, Identify and Assess do not need a schedule; Promote maps risks to activities, the model and results
    // need the calculated schedule, and the reports need a run.
    private bool Enabled(WorkflowStep s) => s switch
    {
        WorkflowStep.Promote or WorkflowStep.Model or WorkflowStep.Results => State.Cpm != null,
        WorkflowStep.Review => State.Pre != null,
        _ => true,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("sraWatchNav");
    }

    private async Task Go(WorkflowStep s)
    {
        step = s;
        await JS.InvokeVoidAsync("scrollTo", 0, 0);
    }

    private async Task RunFromModel()
    {
        await Go(WorkflowStep.Results);
        StateHasChanged();
        await State.RunAsync();
    }
}

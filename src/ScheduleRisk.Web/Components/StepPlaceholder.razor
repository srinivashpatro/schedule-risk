@* A workflow step that is not built yet: its heading and what it will hold (ROADMAP.md, Risk workflow). *@

<section class="hero rule-b">
    <div class="hero-text">
        <span class="kicker">@Info.Kicker</span>
        <h1>@Info.Title</h1>
        <p class="lede">@Info.Description</p>
    </div>
    <div class="hero-drop placeholder-body">
        <span class="eyebrow">Coming in this step</span>
        <ul class="steps-list">
            @foreach (var item in Info.Planned)
            {
                <li>@item</li>
            }
        </ul>
        <p class="sub">Until then, risks are entered directly in step 05 · Model.</p>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public WorkflowStepInfo Info { get; set; } = null!;
}

@inherits StateComponent
@inject HttpClient Http

@if (State.Schedule == null)
{
    <section class="landing blueprint rule-b">
        <div class="landing-text">
            <span class="kicker">Step 01 · Schedule</span>
            <h1>Schedule risk analysis for Primavera&nbsp;P6</h1>
            <p class="lede">Open a P6 export (.xer). It is recalculated with P6's rules, checked and simulated in this browser. Nothing is uploaded.</p>
            @ProjectPicker
        </div>
        <div class="landing-drop">
            @DropZone(slim: false)
        </div>
        <div class="landing-art">
            <LandingArt Kind="hero" />
        </div>
    </section>

    <section class="step-cards rule-b" aria-label="How it works">
        <div class="step-card">
            <span class="num">01</span>
            <h4>Schedule</h4>
            <div class="card-art"><LandingArt Kind="schedule" /></div>
            <p class="body">Recalculated with P6's rules (calendars, constraints, lags and progress) and checked against the dates P6 saved in the file, with DCMA-style health checks.</p>
        </div>
        <div class="step-card">
            <span class="num">02</span>
            <h4>Risk model</h4>
            <div class="card-art"><LandingArt Kind="risk" /></div>
            <p class="body">Three-point uncertainty, a risk register with mitigation, risk drivers and correlation. Open or save the model as JSON.</p>
        </div>
        <div class="step-card">
            <span class="num">03</span>
            <h4>Results</h4>
            <div class="card-art"><LandingArt Kind="results" /></div>
            <p class="body">Monte Carlo simulation with Latin Hypercube sampling, reproducible by seed: P-dates, criticality, sensitivity and a risk ranking. Export an HTML report or CSVs.</p>
        </div>
    </section>

    <section class="poster">
        <p class="poster-text">Your schedule never leaves this browser.</p>
        <p class="poster-sub">The analysis engine runs here, in WebAssembly. XER files are read on this device and never uploaded.</p>
    </section>
}
else
{
    var s = State.Schedule;
    var r = State.Cpm;
    <section class="file-strip blueprint rule-b">
        <div class="fs-file">
            <span class="kicker">Step 01 · Schedule</span>
            <span class="fs-name" title="@State.FileName">@State.FileName</span>
        </div>
        @ProjectPicker
        @DropZone(slim: true)
    </section>
    <section class="stats rule-b">
        <div class="stat"><span class="eyebrow">Project</span><span class="v">@s.ProjectCode</span></div>
        <div class="stat"><span class="eyebrow">Activities</span><span class="v">@s.Activities.Count.ToString("N0")</span></div>
        <div class="stat"><span class="eyebrow">Logic links</span><span class="v">@s.Relationships.Count.ToString("N0")</span></div>
        <div class="stat"><span class="eyebrow">Data date</span><span class="v">@AppState.Day(s.Settings.DataDate)</span></div>
        @if (r != null)
        {
            <div class="stat"><span class="eyebrow">Deterministic finish</span><span class="v">@AppState.Day(r.ProjectFinish)</span></div>
            <div class="stat"><span class="eyebrow">Critical activities</span><span class="v">@CriticalCount.ToString("N0")</span></div>
        }
    </section>

    <section class="pad rule-b stack">
        <div class="headrow">
            <h4>Engine check against P6</h4>
            @if (State.Verify is { Compared: > 0 } v)
            {
                <span class="tag @(v.Passed ? "tag-neutral" : "tag-accent")">@(v.Passed ? "✓ Matches P6" : "! Review")</span>
            }
            else if (r != null)
            {
                <span class="tag tag-neutral">Skipped</span>
            }
        </div>
        @if (State.Verify is { Compared: > 0 } vr)
        {
            if (vr.Passed)
            {
                <p class="body">All @vr.FieldsCompared.ToString("N0") early/late dates and float values recalculated here agree with the values P6 saved in this file.</p>
            }
            else
            {
                <p class="body">
                    <b>@vr.FieldsMatched.ToString("N0") of @vr.FieldsCompared.ToString("N0")</b> dates and float values match P6
                    (@vr.ActivitiesMatched.ToString("N0") of @vr.Compared.ToString("N0") activities fully match).
                    Differences usually mean the file uses a P6 option the engine does not handle yet, or the file was not rescheduled before export.
                </p>
                <details>
                    <summary>Show the largest differences</summary>
                    <div class="wrap">
                        <table class="table">
                            <thead><tr><th>Activity</th><th>Field</th><th>P6</th><th>Ours</th><th class="n">Difference (h)</th></tr></thead>
                            <tbody>
                                @foreach (var d in vr.Worst(40))
                                {
                                    <tr><td>@d.Code</td><td>@d.Field.Replace('_', ' ')</td><td>@(d.Field == "total_float" ? Num(d.P6 / 60.0) + " h" : AppState.DayTime(d.P6))</td>
                                        <td>@(d.Field == "total_float" ? Num(d.Ours / 60.0) + " h" : AppState.DayTime(d.Ours))</td><td class="n">@Num(d.DeltaMinutes / 60.0)@if (d.OutsideCalendar) {<br /><span class="hint">elapsed · outside calendar range</span>}</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        }
        else if (r != null)
        {
            <p class="body">This file has no P6-calculated dates to compare with (it may not have been scheduled before export), so the engine check was skipped.</p>
        }
        @if (State.Warnings.Count > 0)
        {
            <details>
                <summary>@State.Warnings.Count file warnings</summary>
                <ul class="small">
                    @foreach (var w in State.Warnings.Take(200))
                    {
                        <li>@w</li>
                    }
                </ul>
            </details>
        }
    </section>

    if (State.Checks.Count > 0)
    {
        <section class="pad rule-b stack">
            <div class="headrow">
                <h4>Schedule health</h4>
                <span class="sub">@State.Checks.Count(c => c.Passed) of @State.Checks.Count checks pass</span>
            </div>
            <div class="wrap">
                <table class="table">
                    <thead><tr><th>Check</th><th>Result</th><th class="n">Count</th><th class="n">%</th><th>Notes</th></tr></thead>
                    <tbody>
                        @foreach (var c in State.Checks)
                        {
                            <tr>
                                <td class="strong">@c.Title</td>
                                <td><span class="tag @(c.Passed ? "tag-neutral" : "tag-accent")">@(c.Passed ? "✓ Pass" : "! Review")</span></td>
                                <td class="n">@c.Count / @c.Total</td>
                                <td class="n">@Num(c.Pct)</td>
                                <td class="small">
                                    @c.Note
                                    @if (c.Items.Count > 0 && !c.Passed)
                                    {
                                        <details><summary>@Math.Min(c.Items.Count, 100) items</summary><span class="small">@string.Join(", ", c.Items.Take(100))</span></details>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    if (r != null)
    {
        <section class="pad stack">
            <div class="headrow">
                <h4>Parsed activities</h4>
                <span class="tag tag-neutral">@State.FileName · @Rows.Count.ToString("N0") shown</span>
            </div>
            <div class="toolbar">
                <input class="input" type="search" placeholder="Search ID or name" aria-label="Search activities" @bind="search" @bind:event="oninput" />
                <label class="check"><input type="checkbox" @bind="criticalOnly" /> Critical only</label>
            </div>
            <div class="grid-wrap">
                <table class="table">
                    <thead>
                        <tr><th>ID</th><th>Activity</th><th>Status</th><th class="n">Rem. dur (d)</th><th>Early start</th><th>Early finish</th><th>Late finish</th><th class="n">Float (d)</th></tr>
                    </thead>
                    <tbody>
                        <Virtualize Items="Rows" Context="a" ItemSize="37" OverscanCount="20">
                            @{ int j = a.Index; double mpd = a.Calendar.MinutesPerDay; }
                            <tr class="@(r.IsCritical(s, j) ? "crit" : "")">
                                <td class="dim">@a.Code</td>
                                <td class="strong">@a.Name</td>
                                <td class="small">@StatusText(a)</td>
                                <td class="n">@Num(a.RemainingDuration / mpd)</td>
                                <td>@AppState.DayTime(r.ES[j])</td>
                                <td>@AppState.DayTime(r.EF[j])</td>
                                <td>@AppState.DayTime(r.LF[j])</td>
                                <td class="n">@(r.TF[j] == Time.None ? "" : Num(r.TF[j] / mpd))</td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
            <p class="sub">Red edge = critical. Durations and float are in working days of each activity's calendar. Calculated in @State.CpmTime.TotalMilliseconds.ToString("F0") ms.</p>
            <div class="actions-end">
                <button class="btn btn-secondary" @onclick="ExportCsv">Download dates (CSV)</button>
                <button class="btn btn-primary btn-wide" @onclick="() => OnNext.InvokeAsync()">Set up risk model →</button>
            </div>
        </section>
    }
}

@code {
    [Parameter] public EventCallback OnNext { get; set; }

    private string search = "";
    private bool criticalOnly;
    private bool dragging;

    private RenderFragment ProjectPicker => @<text>
        @if (State.Projects.Count > 1)
        {
            <div class="field">
                <label for="project">Project in this file</label>
                <select id="project" class="input" value="@State.ProjectId" @onchange="OnProject">
                    @foreach (var p in State.Projects)
                    {
                        <option value="@p.Id">@p.ShortName</option>
                    }
                </select>
            </div>
        }
    </text>;

    /// <summary>The file drop zone: large on the landing page, one line once a schedule is open.</summary>
    private RenderFragment DropZone(bool slim) => @<div class="dropzone @(slim ? "slim" : "") @(dragging ? "over" : "")">
        <InputFile id="xer-file" class="drop-input" accept=".xer" OnChange="OnFile" title="Drop an .xer file or click to browse"
                   @ondragenter="@(() => dragging = true)" @ondragleave="@(() => dragging = false)" @ondrop="@(() => dragging = false)" />
        @if (slim)
        {
            <span class="drop-title">Drop another .xer here</span>
        }
        else
        {
            <div class="drop-head"><LandingArt Kind="doc" /><span class="drop-title">Drop an .xer file here</span></div>
            <span class="sub">Primavera P6 export · read on this device</span>
        }
        <div class="drop-actions">
            <label for="xer-file" class="btn btn-secondary">Browse files</label>
            <button class="btn btn-ghost" @onclick="LoadSample">Use sample project</button>
        </div>
    </div>;

    private int CriticalCount => State.Schedule == null || State.Cpm == null ? 0
        : State.Schedule.Activities.Count(a => State.Cpm.IsCritical(State.Schedule, a.Index));

    private List<Activity> Rows
    {
        get
        {
            var s = State.Schedule;
            var r = State.Cpm;
            if (s == null || r == null) return new List<Activity>();
            IEnumerable<Activity> q = s.Activities;
            if (criticalOnly) q = q.Where(a => r.IsCritical(s, a.Index));
            if (!string.IsNullOrWhiteSpace(search))
            {
                string t = search.Trim();
                q = q.Where(a => a.Code.Contains(t, StringComparison.OrdinalIgnoreCase) || a.Name.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            return q.ToList();
        }
    }

    private static string StatusText(Activity a) => a.Status switch
    {
        ActivityStatus.Complete => "Complete",
        ActivityStatus.InProgress => "In progress",
        _ => a.IsMilestone ? "Milestone" : a.IsSummary ? "Summary" : "Not started",
    };

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        dragging = false;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 500L * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            await State.LoadXerAsync(e.File.Name, ms.ToArray());
            search = "";
            criticalOnly = false;
        }
        catch (Exception ex)
        {
            State.Error = "Could not open the file: " + ex.Message;
            State.Notify();
        }
    }

    private async Task LoadSample()
    {
        await State.LoadSampleAsync(Http);
        search = "";
        criticalOnly = false;
    }

    private Task OnProject(ChangeEventArgs e) => State.SelectProjectAsync(e.Value?.ToString() ?? "");

    private async Task ExportCsv()
    {
        if (State.Schedule == null || State.Cpm == null) return;
        await Download($"{State.Schedule.ProjectCode}-cpm.csv", "text/csv", CsvExport.Cpm(State.Schedule, State.Cpm));
    }
}

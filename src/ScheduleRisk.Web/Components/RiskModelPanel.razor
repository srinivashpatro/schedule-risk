@inherits StateComponent

@{ var m = State.Model; var codeTypes = State.CodeTypes.ToList(); }

<div class="row">
    <div>
        <input class="w-text" @bind="m.Name" style="font-weight:600;font-size:16px;min-width:280px" aria-label="Model name" />
    </div>
    <span class="spacer"></span>
    <label class="btn">Open model… <InputFile OnChange="OnImport" style="display:none" /></label>
    <button @onclick="Save">Save model</button>
    <button @onclick="Reset">New model</button>
    <button @onclick="Check">Check model</button>
    <button class="primary" @onclick="() => OnNext.InvokeAsync()">Next: simulate →</button>
</div>
<p class="muted small">The model is saved as a small JSON file you keep with the schedule. The command-line tool reads the same file.</p>

@if (checkMessage != null)
{
    <div class="@(checkOk ? "good" : "error")">
        @checkMessage
        @if (checkLines.Count > 0)
        {
            <ul class="small">
                @foreach (var l in checkLines)
                {
                    <li>@l</li>
                }
            </ul>
        }
    </div>
}

<h2>Duration uncertainty</h2>
<p class="muted small">How much each remaining duration could vary. Percent: 90 / 100 / 120 means 10% shorter to 20% longer. Later rows override earlier rows for the activities they select.</p>
<div class="card wrap" style="padding:0">
    <table class="plain">
        <tr><th>Applies to</th><th>Distribution (min / most likely / max)</th><th>Units</th><th></th></tr>
        @foreach (var u in m.Uncertainty)
        {
            <tr>
                <td><FilterEditor Spec="u.Filter" CodeTypes="codeTypes" /></td>
                <td><DistEditor Dist="u.Dist" /></td>
                <td><select @bind="u.Units"><option value="percent">% of duration</option><option value="days">working days</option></select></td>
                <td><button class="link danger" @onclick="() => m.Uncertainty.Remove(u)">Remove</button></td>
            </tr>
        }
    </table>
</div>
<button class="link" @onclick="AddUncertainty">+ Add uncertainty row</button>

<h2>Risk register</h2>
<p class="muted small">Discrete events. If a risk occurs in an iteration, its impact is added to <b>each</b> activity it applies to, so map it to the activities it really hits.</p>
<div class="card wrap" style="padding:0">
    <table class="plain">
        <tr><th>ID</th><th>Title</th><th class="n">Probability</th><th>Impact (min / ML / max)</th><th>Units</th><th>Applies to</th><th>Mitigation</th><th></th></tr>
        @foreach (var r in m.Risks)
        {
            <tr>
                <td><input class="w-id" @bind="r.Id" /></td>
                <td><input class="w-text" @bind="r.Title" /></td>
                <td class="n"><input type="number" min="0" max="100" step="1" value="@Num(r.Probability * 100, 0)" @onchange="@(e => r.Probability = ParsePct(e))" />%</td>
                <td><DistEditor Dist="r.Impact" /></td>
                <td><select @bind="r.ImpactUnits"><option value="days">days</option><option value="percent">% of dur.</option></select></td>
                <td><FilterEditor Spec="r.Filter" CodeTypes="codeTypes" /></td>
                <td>
                    <label class="chk"><input type="checkbox" @bind="r.Mitigated" /> Mitigated</label>
                    @if (r.Mitigated)
                    {
                        <div class="filter" style="margin-top:4px">
                            <input type="number" min="0" max="100" step="1" value="@Num(r.MitigatedProbability * 100, 0)" @onchange="@(e => r.MitigatedProbability = ParsePct(e))" />%
                            <label class="chk small"><input type="checkbox" @bind="r.MitigatedImpactDiffers" /> new impact</label>
                        </div>
                        if (r.MitigatedImpactDiffers)
                        {
                            <div style="margin-top:4px"><DistEditor Dist="r.MitigatedImpact" /></div>
                        }
                    }
                </td>
                <td><button class="link danger" @onclick="() => m.Risks.Remove(r)">Remove</button></td>
            </tr>
        }
    </table>
</div>
<button class="link" @onclick="AddRisk">+ Add risk</button>

<h2>Risk drivers</h2>
<p class="muted small">A factor (in %) sampled once per iteration and applied to every selected activity, e.g. site productivity 95 / 105 / 125. It makes those activities move together.</p>
<div class="card wrap" style="padding:0">
    <table class="plain">
        <tr><th>ID</th><th>Title</th><th class="n">Probability</th><th>Factor % (min / ML / max)</th><th>Applies to</th><th></th></tr>
        @foreach (var d in m.Drivers)
        {
            <tr>
                <td><input class="w-id" @bind="d.Id" /></td>
                <td><input class="w-text" @bind="d.Title" /></td>
                <td class="n"><input type="number" min="0" max="100" step="1" value="@Num(d.Probability * 100, 0)" @onchange="@(e => d.Probability = ParsePct(e))" />%</td>
                <td><DistEditor Dist="d.Factor" /></td>
                <td><FilterEditor Spec="d.Filter" CodeTypes="codeTypes" /></td>
                <td><button class="link danger" @onclick="() => m.Drivers.Remove(d)">Remove</button></td>
            </tr>
        }
    </table>
</div>
<button class="link" @onclick="AddDriver">+ Add driver</button>

<h2>Correlation</h2>
<p class="muted small">Activities whose durations tend to over-run together (same crew, same contractor). Applies to their duration uncertainty; 0 = independent, 0.9 = almost in lock-step.</p>
<div class="card wrap" style="padding:0">
    <table class="plain">
        <tr><th>Activities</th><th class="n">Coefficient</th><th></th></tr>
        @foreach (var c in m.Correlations)
        {
            <tr>
                <td><FilterEditor Spec="c.Filter" CodeTypes="codeTypes" /></td>
                <td class="n"><input type="number" min="-0.99" max="0.99" step="0.05" @bind="c.Coefficient" /></td>
                <td><button class="link danger" @onclick="() => m.Correlations.Remove(c)">Remove</button></td>
            </tr>
        }
    </table>
</div>
<button class="link" @onclick="AddCorrelation">+ Add correlation group</button>

<h2>Simulation settings</h2>
<div class="card">
    <div class="row">
        <label>Iterations <input type="number" min="100" max="100000" step="100" @bind="m.Iterations" /></label>
        <label>Seed <input type="number" @bind="m.Seed" style="width:110px" /></label>
        <button class="link" @onclick="NewSeed">new seed</button>
        <label>Sampling
            <select value="@(m.LatinHypercube ? "lhs" : "mc")" @onchange="@(e => m.LatinHypercube = (e.Value?.ToString() ?? "lhs") == "lhs")">
                <option value="lhs">Latin Hypercube</option>
                <option value="mc">Monte Carlo</option>
            </select>
        </label>
        <label class="chk"><input type="checkbox" @bind="m.Convergence.Enabled" /> Stop when converged</label>
    </div>
    @if (m.Convergence.Enabled)
    {
        <div class="row" style="margin-top:10px">
            <label>P <input class="w-sm" type="number" min="1" max="99" @bind="m.Convergence.Percentile" /> moves less than
                <input class="w-sm" type="number" step="0.1" min="0" @bind="m.Convergence.ToleranceDays" /> days</label>
            <label>batch <input type="number" min="50" step="50" @bind="m.Convergence.BatchSize" /></label>
            <label>min <input type="number" min="100" step="100" @bind="m.Convergence.MinIterations" /></label>
            <label>max <input type="number" min="100" step="100" @bind="m.Convergence.MaxIterations" /></label>
        </div>
        <p class="muted small">Iterations above is ignored while convergence is on.</p>
    }
    <p class="muted small">The same schedule, model and seed always give the same results.</p>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }

    private string? checkMessage;
    private bool checkOk;
    private readonly List<string> checkLines = new();

    private static double ParsePct(ChangeEventArgs e) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? Math.Clamp(v / 100.0, 0, 1) : 0;

    private void AddUncertainty() => State.Model.Uncertainty.Add(new UncertaintyRow());

    private void AddRisk() => State.Model.Risks.Add(new RiskRow { Id = State.Model.NextRiskId(), Title = "New risk" });

    private void AddDriver()
    {
        int k = State.Model.Drivers.Count + 1;
        State.Model.Drivers.Add(new DriverRow { Id = $"D{k:00}", Title = "New driver" });
    }

    private void AddCorrelation() =>
        State.Model.Correlations.Add(new CorrelationRow { Filter = new FilterSpec { Kind = FilterKind.Code } });

    private void NewSeed() => State.Model.Seed = Random.Shared.NextInt64(1, 1_000_000_000);

    private void Reset()
    {
        State.Model = RiskModelDocument.Default();
        checkMessage = null;
        State.ClearResults();
        State.Notify();
    }

    private async Task Save()
    {
        string name = string.Concat((State.Model.Name ?? "risk-model").Select(ch => char.IsLetterOrDigit(ch) || ch is '-' or '_' ? ch : '-'));
        await Download(name + ".risk.json", "application/json", State.Model.ToJson());
    }

    private async Task OnImport(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            string json = await reader.ReadToEndAsync();
            State.Model = RiskModelDocument.FromJson(json);
            State.ClearResults();
            Check();
        }
        catch (Exception ex)
        {
            checkOk = false;
            checkMessage = "Could not read that model: " + ex.Message;
            checkLines.Clear();
        }
        State.Notify();
    }

    private void Check()
    {
        checkLines.Clear();
        try
        {
            var model = State.CompileModel();
            int unc = model.Uncertainty.Count(u => u != null);
            checkOk = true;
            checkMessage = $"Model is valid: {unc:N0} activities have duration uncertainty, {model.Risks.Count} risks, {model.Drivers.Count} drivers, {model.Correlations.Count} correlation groups.";
            foreach (var r in model.Risks) checkLines.Add($"{r.Id} {r.Title}: {r.Activities.Count} activities");
            foreach (var d in model.Drivers) checkLines.Add($"{d.Id} {d.Title}: {d.Activities.Count} activities");
            foreach (var w in model.Warnings) checkLines.Add("Warning: " + w);
        }
        catch (Exception ex)
        {
            checkOk = false;
            checkMessage = "The model has a problem: " + ex.Message;
        }
    }
}

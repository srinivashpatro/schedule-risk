@inherits StateComponent

@* Open, save or start a register file (the matrix and every risk), kept on this device. Used by Setup, Identify,
   Assess and Promote. The file is an Excel workbook (docs/RISK_REGISTER.md, "Excel workbook") or JSON. *@

<div class="field">
    <label>Register file</label>
    <div class="btn-row">
        <label class="btn btn-secondary">Open… <InputFile OnChange="OnOpen" accept=".xlsx,.json" style="display:none" /></label>
        <button class="btn btn-secondary" @onclick="Save">Save as Excel</button>
        <button class="btn btn-secondary" @onclick="SaveJson">Save as JSON</button>
        <button class="btn btn-secondary" @onclick="Template">Excel template</button>
        <button class="btn btn-secondary" @onclick="New">New</button>
    </div>
    <span class="hint">An Excel workbook (.xlsx) or JSON file you keep on this device: the matrix and every risk. Fill in the
        template in Excel, one risk per row, then open it here; opening replaces the register. Nothing is uploaded.</span>
    @if (message != null)
    {
        <ul class="issues"><li class="err">@message</li></ul>
    }
</div>

@code {
    private const string Xlsx = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    private string? message;

    private string FileName => string.Concat((State.Register.Name ?? "risk-register").Select(ch => char.IsLetterOrDigit(ch) || ch is '-' or '_' ? ch : '-'));

    private void New()
    {
        State.Register = new RiskRegister();
        message = null;
        State.Notify();
    }

    private async Task Save() =>
        await JS.InvokeVoidAsync("sraDownload", FileName + ".register.xlsx", Xlsx, RegisterWorkbook.Write(State.Register));

    private async Task SaveJson() =>
        await Download(FileName + ".register.json", "application/json", State.Register.ToJson());

    /// <summary>An empty workbook on this register's matrix (step 01 Setup), for filling in.</summary>
    private async Task Template() =>
        await JS.InvokeVoidAsync("sraDownload", FileName + ".template.xlsx", Xlsx, RegisterWorkbook.Template(State.Register.Matrix, State.Register.Name));

    private async Task OnOpen(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            State.Register = RiskRegister.Open(ms.ToArray());
            message = null;
            State.Notify();
        }
        catch (Exception ex) when (ex is FormatException or System.Text.Json.JsonException or IOException)
        {
            message = $"Could not open {e.File.Name}: {ex.Message}";
        }
    }
}
